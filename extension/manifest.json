{
  "manifest_version": 3,
  "name": "p8zh Direct",
  "version": "1.0.0",
  "description": "Open the website embedded in p8zh.adj.st links automatically.",
  "permissions": ["webRequest", "webRequestBlocking"],
  "host_permissions": ["*://p8zh.adj.st/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "p8zh-direct@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
