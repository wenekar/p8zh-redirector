{
  "name": "p8zh-direct",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Firefox extension that skips p8zh.adj.st redirect links.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenekar/p8zh-redirector.git"
  },
  "homepage": "https://github.com/wenekar/p8zh-redirector#readme",
  "bugs": "https://github.com/wenekar/p8zh-redirector/issues",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run lint:extension",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:extension": "web-ext lint --source-dir extension --warnings-as-errors",
    "start": "web-ext run --source-dir extension",
    "test": "c8 node --test tests/*.test.js",
    "test:unit": "node --test tests/redirect.test.js",
    "test:build": "node --test tests/build.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "22.20.5",
    "@types/selenium-webdriver": "4.35.7",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "selenium-webdriver": "4.51.0",
    "typescript": "7.0.2",
    "web-ext": "10.8.0"
  },
  "files": [
    ".c8rc.json",
    ".editorconfig",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".prettierignore",
    ".prettierrc.json",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "PRIVACY.md",
    "README.md",
    "docs",
    "eslint.config.js",
    "extension",
    "package.json",
    "package-lock.json",
    "scripts",
    "tests",
    "tsconfig.json"
  ]
}
